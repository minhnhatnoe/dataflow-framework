+/// SCRATCH profiling hook (not to be committed): run the plan walk at run time.
+#[doc(hidden)]
+pub fn __plan_rt<R: Root, S: SinkList>() -> (usize, usize, usize)
+where
+    S::Subs: const Upstream,
+{
+    let h = std::thread::Builder::new().stack_size(1 << 29).spawn(|| {
+        let t = std::time::Instant::now();
+        let p = Box::new(Plan::of::<Anchor<R, S>>(TypeId::of::<R>()));
+        eprintln!("plan runtime: {:?}", t.elapsed());
+        eprintln!("excl iters={} scanned={} nonePairs={} guard={} maxgrp={} noneBlocks={} logged={}", p.dbg[0], p.dbg[1], p.dbg[2], p.dbg[3], p.dbg[4], p.dbg[5], p.dbg[6]);
+        eprintln!("big groups [place,zero,size,len0]: {:?}", &p.dbg[58..70]);
+        for k in 0..p.dbg[6] as usize {
+            let s = 8 + 5 * k;
+            eprintln!("  comp idx {} terms {} iters {} nonePairs {} scanned {}", p.dbg[s], p.dbg[s + 1], p.dbg[s + 2], p.dbg[s + 3], p.dbg[s + 4]);
+        }
+        (p.len(), p.n_components(), p.prog_len())
+    });
+    h.unwrap().join().unwrap()
+}
